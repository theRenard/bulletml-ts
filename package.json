{
  "name": "bulletml-ts",
  "version": "0.1.0",
  "description": "A TypeScript BulletML parser and runner for danmaku (bullet hell) patterns. Zero dependencies, runs in Node and browsers.",
  "keywords": [
    "bulletml",
    "danmaku",
    "bullet-hell",
    "shmup",
    "game",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite playground",
    "build:playground": "vite build playground",
    "preview": "vite preview playground"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
