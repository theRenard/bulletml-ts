{
  "name": "bulletml-ts",
  "version": "0.1.0",
  "description": "A TypeScript BulletML parser and runner for danmaku (bullet hell) patterns. Zero dependencies, runs in Node and browsers.",
  "keywords": [
    "bulletml",
    "danmaku",
    "bullet-hell",
    "shmup",
    "game",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite playground",
    "build:playground": "vite build playground",
    "preview": "vite preview playground",
    "bench": "node scripts/bench.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "codemirror": "^6.0.2",
    "fengari": "^0.1.5",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theRenard/bulletml-ts.git"
  },
  "homepage": "https://therenard.github.io/bulletml-ts/",
  "bugs": {
    "url": "https://github.com/theRenard/bulletml-ts/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
