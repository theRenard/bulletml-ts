<?xml version="1.0" ?>
<bulletml type="vertical">
  <!-- Bullets start slow, then speed up with changeSpeed. -->
  <action label="top">
    <repeat><times>9999</times>
      <action>
        <fire><direction type="aim">0</direction><speed>0.5</speed><bulletRef label="fast"/></fire>
        <wait>10</wait>
      </action>
    </repeat>
  </action>
  <bullet label="fast">
    <action>
      <wait>30</wait>
      <changeSpeed><speed>5</speed><term>40</term></changeSpeed>
    </action>
  </bullet>
</bulletml>
